<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lays out every blueprint without the game and checks the pieces against each other. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>LivingFactions.BlueprintCheck</RootNamespace>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="..\..\src\LivingFactions.Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\..\src\LivingFactions\Blueprints.cs" Link="Game\Blueprints.cs" />
    <Reference Include="$(ManagedDir)\assembly_valheim.dll" Private="true" />
    <Reference Include="$(ManagedDir)\assembly_utils.dll" Private="true" />
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll" Private="true" />
    <Reference Include="$(ManagedDir)\netstandard.dll" Private="true" />
    <Reference Include="$(ManagedDir)\UnityEngine.dll" Private="true" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="true" />
  </ItemGroup>
</Project>
