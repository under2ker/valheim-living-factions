<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LivingFactions.Harness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\LivingFactions.Core\**\*.cs" LinkBase="Core" />
    <!-- The game ships Newtonsoft.Json; the plugin uses that same copy for saves. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
