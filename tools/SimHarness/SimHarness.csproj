<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LivingFactions.Harness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/LivingFactions.Core/**/*.cs" LinkBase="Core" />
    <!-- The harness checks the core without the game, so it brings its own copy of the serializer.
         The plugin still uses the game's copy; the save format is plain JSON. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
