<Project>
  <PropertyGroup>
    <!-- Where Valheim is installed. Override with the VALHEIM_INSTALL environment variable. -->
    <ValheimDir Condition="'$(VALHEIM_INSTALL)' != ''">$(VALHEIM_INSTALL)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
  </PropertyGroup>
</Project>
